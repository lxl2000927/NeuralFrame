{
  "name": "neuralframe",
  "version": "0.1.2",
  "distribution": {
    "channel": "independent",
    "releaseRepository": "lxl2000927/NeuralFrame",
    "upstreamVersion": "2.3.0",
    "upstreamRepository": "skyi7943-cmd/DLSS5-Swapper-Enhanced"
  },
  "description": "Neural rendering and frame generation manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "electron scripts/test-game-filters-ui.js",
    "test:payload": "node scripts/test-feeder-payload.js",
    "test:optiscaler": "node scripts/test-optiscaler-payload.js",
    "payload": "node scripts/collect-payload.js",
    "prebuild": "npm run build:ui && node scripts/verify-runtime-bootstrap.js",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage deb",
    "icon": "electron scripts/make-icon.js",
    "build:portable": "electron-builder --win portable",
    "overlay:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-overlay.ps1",
    "overlay:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-overlay.ps1",
    "prebuild:portable": "npm run build:ui && node scripts/verify-runtime-bootstrap.js",
    "dev:ui": "vite",
    "check:ui": "tsc --noEmit",
    "build:ui": "tsc --noEmit && vite build",
    "prestart": "npm run build:ui"
  },
  "author": {
    "name": "lxl2000927",
    "url": "https://github.com/lxl2000927"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lxl2000927/NeuralFrame.git"
  },
  "homepage": "https://github.com/lxl2000927/NeuralFrame",
  "bugs": {
    "url": "https://github.com/lxl2000927/NeuralFrame/issues"
  },
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^33.2.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^1.70.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "io.github.lxl2000927.neuralframe",
    "productName": "NeuralFrame",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "THIRD_PARTY_NOTICES.md",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/runtime-bootstrap",
        "to": "payload",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/overlay",
        "to": "overlay",
        "filter": [
          "*.addon64",
          "*.txt",
          "*.md",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/neuralframe/app.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "skyi7943-cmd",
      "icon": "app_iocn.png",
      "artifactName": "NeuralFrame-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "lxl2000927",
      "repo": "NeuralFrame",
      "releaseType": "draft"
    },
    "portable": {
      "unpackDirName": true,
      "useZip": true,
      "artifactName": "NeuralFrame-${version}-Portable-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NeuralFrame",
      "installerIcon": "assets/neuralframe/app.ico",
      "uninstallerIcon": "assets/neuralframe/app.ico",
      "installerHeaderIcon": "assets/neuralframe/app.ico",
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "artifactName": "NeuralFrame-${version}-Setup-x64.exe",
      "include": "build/installer.nsh"
    }
  }
}
