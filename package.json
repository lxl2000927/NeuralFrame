{
  "name": "dlss5-swapper-enhanced",
  "version": "0.1.8",
  "distribution": {
    "channel": "independent",
    "releaseRepository": "lxl2000927/DLSS5-Swapper-Enhanced",
    "upstreamVersion": "2.3.0",
    "upstreamRepository": "skyi7943-cmd/DLSS5-Swapper-Enhanced"
  },
  "description": "DLSS 5 Neural Rendering & RTX 40 MFG x3/x4 Manager (Enhanced Edition with 8GB VRAM Optimization & Full Chinese In-Game Overlay)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "electron scripts/test-game-filters-ui.js",
    "test:payload": "node scripts/test-feeder-payload.js",
    "test:optiscaler": "node scripts/test-optiscaler-payload.js",
    "payload": "node scripts/collect-payload.js",
    "prebuild": "node scripts/verify-runtime-bootstrap.js",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage deb",
    "icon": "electron scripts/make-icon.js",
    "build:portable": "electron-builder --win portable",
    "overlay:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-overlay.ps1",
    "overlay:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-overlay.ps1",
    "prebuild:portable": "node scripts/verify-runtime-bootstrap.js"
  },
  "author": {
    "name": "lxl2000927",
    "url": "https://github.com/lxl2000927"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lxl2000927/DLSS5-Swapper-Enhanced.git"
  },
  "homepage": "https://github.com/lxl2000927/DLSS5-Swapper-Enhanced",
  "bugs": {
    "url": "https://github.com/lxl2000927/DLSS5-Swapper-Enhanced/issues"
  },
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.lxl2000927.dlss5swapper.enhanced",
    "productName": "DLSS 5 Swapper Enhanced",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "THIRD_PARTY_NOTICES.md",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/runtime-bootstrap",
        "to": "payload",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/overlay",
        "to": "overlay",
        "filter": [
          "*.addon64",
          "*.txt",
          "*.md",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "skyi7943-cmd",
      "icon": "app_iocn.png",
      "artifactName": "DLSS5-Swapper-Enhanced-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "lxl2000927",
      "repo": "DLSS5-Swapper-Enhanced",
      "releaseType": "draft"
    },
    "portable": {
      "unpackDirName": true,
      "useZip": true,
      "artifactName": "DLSS5-Swapper-Enhanced-${version}-Portable-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DLSS 5 Swapper Enhanced",
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerHeaderIcon": "assets/app.ico",
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "artifactName": "DLSS5-Swapper-Enhanced-${version}-Setup-x64.exe",
      "include": "build/installer.nsh"
    }
  }
}
